generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         String     // "leader", "hrd", "admin", "pmc"
  employeeId   String?
  department   String?
  position     String?
  jatahcuti    Int        @default(12)
  cutiterpakai Int        @default(0)
  sisaCuti     Int        @default(12)  // Added this field
  forms        Form[]     @relation("EmployeeForms")
  approvals    Approval[] @relation("ApproverApprovals")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Form {
  id                  String     @id @default(cuid())
  formNumber          Int?       @unique // Sequential form number
  type                String     // "leave", "overtime"
  status              String     // "pending", "approved", "rejected", "process"
  data                Json       // Form data
  employeeId          String
  employee            User       @relation("EmployeeForms", fields: [employeeId], references: [id])
  employeeSignature   String?    // Base64 encoded signature
  supportingDocuments String[]   // Array of file URLs
  pmSignature         String?    // Production Manager signature (Base64 encoded)
  pmApprovalDate      DateTime?  // When the Production Manager approved
  approvals           Approval[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Approval {
  id         String   @id @default(cuid())
  formId     String
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  role       String   // "leader", "hrd", "pmc"
  status     String   // "pending", "approved", "rejected", "process"
  approverId String?
  approver   User?    @relation("ApproverApprovals", fields: [approverId], references: [id])
  signature  String?  // Base64 encoded signature
  comments   String?  // Comments or rejection reason
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}