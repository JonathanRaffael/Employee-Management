generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// USER (LOGIN ACCOUNT)
//////////////////////////////////////////////////////

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String?
  role       String?
  department String?
  position   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  approvals     Approval[]     @relation("ApproverApprovals")
  createdForms Form[]         @relation("FormCreator")
  notifications Notification[]
  employee      Employee?

  @@index([role])
  @@index([department])
}

//////////////////////////////////////////////////////
// EMPLOYEE (NON LOGIN ENTITY)
//////////////////////////////////////////////////////

model Employee {
  id           String   @id @default(cuid())
  userId       String?  @unique
  employeeCode String
  name         String
  department   String
  position     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  leaveBalances LeaveBalance[]
  forms         Form[]

  @@index([employeeCode])
  @@index([department])
}

//////////////////////////////////////////////////////
// LEAVE BALANCE
//////////////////////////////////////////////////////

model LeaveBalance {
  id         String @id @default(cuid())
  employeeId String
  year       Int
  total      Int
  used       Int    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
}

//////////////////////////////////////////////////////
// FORM (NO APPROVAL LOGIC HERE)
//////////////////////////////////////////////////////

model Form {
  id         String   @id @default(cuid())
  type       String
  status     String
  data       Json?

  // employee yang diajukan
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // user pembuat form (leader / employee login)
  createdById String
  createdBy   User   @relation("FormCreator", fields: [createdById], references: [id])

  supportingDocuments String[]
  formNumber          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals Approval[]

  jobRequisition  JobRequisitionForm?
  trainingRequest TrainingRequestForm?

  @@unique([type, formNumber])
  @@index([status])
  @@index([type])
  @@index([employeeId])
  @@index([createdById])
}

//////////////////////////////////////////////////////
// APPROVAL = SINGLE SOURCE OF TRUTH
//////////////////////////////////////////////////////

model Approval {
  id         String   @id @default(cuid())
  formId     String
  role       String
  status     String   // PENDING | APPROVED | REJECTED
  approverId String?
  signature  String?
  comments   String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  approver User? @relation("ApproverApprovals", fields: [approverId], references: [id])
  form     Form  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, role])
  @@index([formId])
  @@index([role])
  @@index([status])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

//////////////////////////////////////////////////////
// JOB REQUISITION
//////////////////////////////////////////////////////

model JobRequisitionForm {
  formId            String               @id
  requestPosition   String
  departmentName    String
  expectedStartDate DateTime?
  skillsRequired    String?
  explanation       String?
  positionDuration  PositionDurationType
  endDate           DateTime?
  employmentType    EmploymentType
  salaryRange       String?
  budgetStatus      BudgetStatus
  remarks           String?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// TRAINING REQUEST
//////////////////////////////////////////////////////

model TrainingRequestForm {
  formId                 String @id
  fullName               String
  employeeCode           String?
  departmentName         String?
  position               String?
  contactInfo            String?
  trainingTitle          String
  trainingProvider       String?
  startDate              DateTime?
  endDate                DateTime?
  trainingLocation       String?
  trainingMode           TrainingMode?
  trainingDuration       String?
  accommodationRequired  Boolean @default(false)
  checkInDate            DateTime?
  nights                 Int?
  preferredAccommodation String?
  trainingObjectives     String?
  employeeCategory       EmployeeCategory?
  hrStatus               String?
  hrComments             String?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum EmploymentType {
  PART_TIME
  FULL_TIME
  CONTRACT
}

enum PositionDurationType {
  PERMANENT
  TEMPORARY
}

enum BudgetStatus {
  SUFFICIENT
  REQUIRES_ADDITIONAL
}

enum TrainingMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum EmployeeCategory {
  STAFF
  NON_STAFF
}
