// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          String     // "leader", "hrd", "admin"
  employeeId    String?
  department    String?
  position      String?
  forms         Form[]     @relation("EmployeeForms")
  approvals     Approval[] @relation("ApproverApprovals")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Form {
  id                  String     @id @default(cuid())
  type                String     // "leave", "overtime"
  status              String     // "pending", "approved", "rejected"
  data                Json       // Form data
  employeeId          String
  employee            User       @relation("EmployeeForms", fields: [employeeId], references: [id])
  employeeSignature   String?    // Base64 encoded signature
  supportingDocuments String[]   // Array of file URLs
  approvals           Approval[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Approval {
  id          String    @id @default(cuid())
  formId      String
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  role        String    // "leader", "hrd"
  status      String    // "pending", "approved", "rejected"
  approverId  String?
  approver    User?     @relation("ApproverApprovals", fields: [approverId], references: [id])
  signature   String?   // Base64 encoded signature
  comments    String?   // Comments or rejection reason
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
